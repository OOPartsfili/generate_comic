{
  "name": "comic-generator",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:server\" \"npm:client\"",
    "client": "vite --host 127.0.0.1",
    "server": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "start": "electron .",
    "desktop": "npm run build && electron .",
    "pack": "npm run build && electron-builder --win --dir",
    "package": "npm run build && electron-builder --win portable",
    "test": "node --test tests/*.test.js",
    "test:ui": "npm run build && playwright test"
  },
  "dependencies": {
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^0.544.0",
    "openai": "^7.15.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.63.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "vite": "^7.1.5",
    "@vitejs/plugin-react": "^5.0.3",
    "concurrently": "^9.2.1"
  },
  "description": "墨格创作室 · 使用 OpenAI 完成短篇小说与漫画",
  "author": "Moge Studio",
  "main": "desktop/main.cjs",
  "build": {
    "appId": "local.moge.studio",
    "productName": "墨格创作室",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "shared/**/*",
      "desktop/**/*",
      "package.json",
      "!**/.env",
      "!**/data/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "desktop/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "墨格创作室-${version}.exe"
    },
    "asar": true,
    "electronDist": "node_modules/electron/dist"
  }
}
