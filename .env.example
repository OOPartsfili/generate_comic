# Default: official Codex with ChatGPT sign-in. No API key required.
# Optional overrides; never put credentials in these path/model fields.
MOGE_CODEX_PATH=
MOGE_CODEX_MODEL=
# Desktop automatically uses the system HTTP proxy. Development override:
MOGE_PROXY_URL=

# Used only when OpenAI API mode is explicitly selected in the UI.
# Keep real values in an untracked .env file or environment variables.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-2
# Local development server only; desktop uses a random loopback port.
PORT=8787
# Optional custom local data directory.
# MOGE_DATA_DIR=E:/my-comic-library
